<Page
    x:Class="MediaController.GameBar.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Background="Transparent">
        <Border x:Name="RootCard"
                Margin="8"
                Padding="14"
                CornerRadius="18"
                Background="#E61B1327"
                BorderBrush="#20FFFFFF"
                BorderThickness="1"
                Opacity="0">
            <Grid>
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2AA970FF" Offset="0"/>
                        <GradientStop Color="#00100D17" Offset="0.55"/>
                        <GradientStop Color="#247C4DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Width="76" Height="76" VerticalAlignment="Center">
                    <Border CornerRadius="14"
                            Background="#FF24182F"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1">
                        <TextBlock Text="♪"
                                   Foreground="#BBD7C0FF"
                                   FontSize="30"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border x:Name="ArtworkBorder"
                            CornerRadius="14"
                            BorderBrush="#18FFFFFF"
                            BorderThickness="1"
                            Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" Margin="16,0,4,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Music Switch"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ArtistText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13.5"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <TextBlock x:Name="SourceText"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11.5"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
