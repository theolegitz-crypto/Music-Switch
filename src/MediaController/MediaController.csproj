<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MediaController</RootNamespace>
    <AssemblyName>MediaController</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MediaController.ico</ApplicationIcon>

    <!-- v0.4.3: lossless rapid-skip FIFO + non-blocking hotkey intake -->
    <Version>0.4.3</Version>

    <!-- Velopack must run before WPF's generated entry point, so App.xaml is a normal Page
         and App.xaml.cs owns Main(). -->
    <StartupObject>MediaController.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is enabled only for System.Windows.Forms.NotifyIcon (tray icon). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF uses the embedded icon for Settings/tray. A second physical copy is shipped
         specifically for .lnk files so Windows sees a new icon source after updating from
         the icon-less 0.4.0 shortcut and does not keep the old executable icon cache. -->
    <Resource Include="Assets\MediaController.ico" />
    <Content Include="Assets\MediaControllerShortcut.ico"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Empty in developer builds. CI / Build-Installer writes the GitHub repository URL
         into the published copy immediately before Velopack packages it. -->
    <None Update="update-source.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
