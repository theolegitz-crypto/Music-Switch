<Window x:Class="MediaController.UI.TrackPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Controller"
        Width="410"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Opacity="0"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border x:Name="Root"
            Margin="14,10,14,14"
            CornerRadius="18"
            Background="#E61B1327"
            BorderBrush="Transparent"
            BorderThickness="0"
            RenderTransformOrigin="0.5,1">

        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootOffset" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <Border CornerRadius="18" Background="{StaticResource GlassSheenBrush}"/>

            <!-- Track popup. -->
            <Grid x:Name="TrackContent" Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Center">
                    <Ellipse Width="104" Height="104"
                             Fill="{StaticResource ArtworkGlowBrush}"
                             IsHitTestVisible="False"/>

                    <Grid x:Name="ArtworkHost" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ArtworkScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <Border CornerRadius="14"
                                Background="{StaticResource ArtworkPlaceholderBrush}"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="&#x266A;"
                                       FontSize="30"
                                       Foreground="#77C9A8FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border x:Name="ArtworkBorder"
                                CornerRadius="14"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="TextHost" Grid.Column="1" Margin="16,0,2,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText"
                               Grid.Row="0"
                               Text="Unknown track"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <TextBlock x:Name="ArtistText"
                               Grid.Row="1"
                               Text=""
                               Margin="0,3,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="13.5"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <TextBlock x:Name="SourceText"
                               Grid.Row="2"
                               Text=""
                               Margin="0,8,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <!-- Live GSMTC timeline. Hidden when the player does not expose duration. -->
                    <Grid x:Name="TrackTimelineHost" Grid.Row="3" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="TrackProgressRail" Grid.Row="0" Height="4" ClipToBounds="True">
                            <Border Background="#2BFFFFFF" CornerRadius="2"/>
                            <Border x:Name="TrackProgressFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="#A970FF"
                                    CornerRadius="2"/>
                        </Grid>

                        <TextBlock x:Name="TrackTimeText"
                                   Grid.Row="1"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="10.5"
                                   Foreground="#82758F"
                                   Text="0:00 / 0:00"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Vertical music-volume OSD. -->
            <Grid x:Name="VolumeContent" Margin="18,14" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Background="#2A9C5CFF"
                        BorderBrush="#30FFFFFF"
                        BorderThickness="1">
                    <Grid>
                        <Ellipse Width="64" Height="64"
                                 Fill="{StaticResource ArtworkGlowBrush}"
                                 Opacity="0.7"/>
                        <TextBlock x:Name="VolumeGlyphText"
                                   Text="&#x1F50A;"
                                   FontFamily="Segoe UI Emoji"
                                   FontSize="21"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="VolumeHost"
                            Grid.Column="1"
                            Margin="14,0,12,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="VolumeTitleText"
                               Text="Music volume"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock x:Name="VolumePlayerText"
                               Text=""
                               Margin="0,3,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                    <TextBlock x:Name="VolumePercentText"
                               Text="65%"
                               Margin="0,7,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#D7C0FF"/>
                </StackPanel>

                <!-- Vertical level: fills bottom -> top. -->
                <Grid Grid.Column="2"
                      Width="9"
                      Height="76"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      ClipToBounds="True">
                    <Border Background="#30FFFFFF" CornerRadius="4.5"/>
                    <Border x:Name="VolumeFill"
                            Height="0"
                            VerticalAlignment="Bottom"
                            Background="#A970FF"
                            CornerRadius="4.5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="0"
                                              Color="#9C5CFF"
                                              Opacity="0.65"/>
                        </Border.Effect>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
