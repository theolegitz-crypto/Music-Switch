<Window x:Class="MediaController.UI.TrackPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Controller"
        Width="410"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        Opacity="0"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Layered window (AllowsTransparency) rather than a DWM acrylic backdrop: this gives
        real rounded corners, per-pixel alpha and a soft shadow on Windows 10 as well as 11,
        which matters more for a 400px card floating over a game than a real blur would.
    -->
    <Border x:Name="Root"
            Margin="14,10,14,14"
            CornerRadius="18"
            Background="#E61B1327"
            BorderBrush="Transparent"
            BorderThickness="0"
            RenderTransformOrigin="0.5,1">

        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootOffset" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>

        <Grid>
            <!-- Glass sheen: a lit top edge and a faint purple floor. -->
            <Border CornerRadius="18" Background="{StaticResource GlassSheenBrush}"/>

            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ artwork ============ -->
                <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Center">

                    <!-- Purple glow: a radial gradient, not a BlurEffect, so it costs nothing. -->
                    <Ellipse Width="104" Height="104"
                             Fill="{StaticResource ArtworkGlowBrush}"
                             IsHitTestVisible="False"/>

                    <Grid x:Name="ArtworkHost" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ArtworkScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>

                        <!-- Placeholder sits underneath and shows through when there is no cover. -->
                        <Border CornerRadius="14"
                                Background="{StaticResource ArtworkPlaceholderBrush}"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="&#x266A;"
                                       FontSize="30"
                                       Foreground="#77C9A8FF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- ImageBrush on a rounded Border: real corner clipping, no geometry maths. -->
                        <Border x:Name="ArtworkBorder"
                                CornerRadius="14"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ============ text ============ -->
                <StackPanel x:Name="TextHost" Grid.Column="1" Margin="16,0,2,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Unknown track"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <TextBlock x:Name="ArtistText"
                               Text=""
                               Margin="0,3,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="13.5"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>

                    <TextBlock x:Name="SourceText"
                               Text=""
                               Margin="0,10,0,0"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="11.5"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
