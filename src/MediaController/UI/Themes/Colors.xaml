<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Purple Liquid Glass palette.
        Rule of the theme: contrast wins over transparency. Surfaces are translucent,
        text never is.
    -->

    <!-- surfaces -->
    <Color x:Key="WindowBackgroundColor">#FF0F0C16</Color>
    <Color x:Key="GlassBackgroundColor">#B3281B35</Color>
    <Color x:Key="GlassBackgroundHoverColor">#CC352244</Color>
    <Color x:Key="GlassStrongColor">#E61B1526</Color>
    <Color x:Key="GlassSunkenColor">#66150F1F</Color>

    <!-- accents -->
    <Color x:Key="PrimaryPurpleColor">#FFA970FF</Color>
    <Color x:Key="SecondaryPurpleColor">#FF7C4DFF</Color>
    <Color x:Key="PurpleGlowColor">#FF9C5CFF</Color>

    <!-- text -->
    <Color x:Key="PrimaryTextColor">#FFF7F3FF</Color>
    <Color x:Key="SecondaryTextColor">#FFB9AEC5</Color>
    <Color x:Key="MutedTextColor">#FF83798D</Color>

    <!-- lines -->
    <Color x:Key="GlassBorderColor">#1AFFFFFF</Color>
    <Color x:Key="GlassBorderHoverColor">#2EFFFFFF</Color>
    <Color x:Key="ErrorColor">#FFFF7A8A</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="{StaticResource GlassBackgroundColor}"/>
    <SolidColorBrush x:Key="GlassBackgroundHoverBrush" Color="{StaticResource GlassBackgroundHoverColor}"/>
    <SolidColorBrush x:Key="GlassStrongBrush" Color="{StaticResource GlassStrongColor}"/>
    <SolidColorBrush x:Key="GlassSunkenBrush" Color="{StaticResource GlassSunkenColor}"/>

    <SolidColorBrush x:Key="PrimaryPurpleBrush" Color="{StaticResource PrimaryPurpleColor}"/>
    <SolidColorBrush x:Key="SecondaryPurpleBrush" Color="{StaticResource SecondaryPurpleColor}"/>
    <SolidColorBrush x:Key="PurpleGlowBrush" Color="{StaticResource PurpleGlowColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>

    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>
    <SolidColorBrush x:Key="GlassBorderHoverBrush" Color="{StaticResource GlassBorderHoverColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="PurpleHoverBrush" Color="#26A970FF"/>
    <SolidColorBrush x:Key="PurplePressedBrush" Color="#3AA970FF"/>

    <!-- Very slight top highlight: this is what reads as the lit edge of glass. -->
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#14FFFFFF"/>
        <GradientStop Offset="0.45" Color="#00FFFFFF"/>
        <GradientStop Offset="1" Color="#0A7C4DFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PurpleFillBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFA678FF"/>
        <GradientStop Offset="1" Color="#FF7C4DFF"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ArtworkPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF3A2755"/>
        <GradientStop Offset="1" Color="#FF221733"/>
    </LinearGradientBrush>

    <!-- Radial glow behind album art. A gradient costs nothing; a BlurEffect would. -->
    <RadialGradientBrush x:Key="ArtworkGlowBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Offset="0" Color="#889C5CFF"/>
        <GradientStop Offset="0.55" Color="#339C5CFF"/>
        <GradientStop Offset="1" Color="#009C5CFF"/>
    </RadialGradientBrush>

    <CornerRadius x:Key="CardCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="FieldCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="ArtworkCornerRadius">14</CornerRadius>

    <sys:Double x:Key="TitleFontSize">16</sys:Double>
    <sys:Double x:Key="BodyFontSize">13</sys:Double>
    <sys:Double x:Key="CaptionFontSize">11.5</sys:Double>

    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

</ResourceDictionary>
