<Window x:Class="MediaController.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MediaController.UI.Controls"
        Title="Media Controller"
        Width="500"
        Height="900"
        MinWidth="460"
        MinHeight="560"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!--
        Background is a solid brush by default. It is swapped for Transparent at runtime
        only if DwmHelper actually managed to turn Mica on, so an unsupported OS keeps a
        properly painted dark window instead of a see-through one.
    -->

    <DockPanel>

        <!-- ============================ title bar ============================ -->
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="44" Background="Transparent"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource PurpleFillBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Media Controller"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CaptionButtonStyle}" Click="OnMinimise" ToolTip="Minimise"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            Style="{StaticResource CloseButtonStyle}" Click="OnCancel" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== footer ============================= -->
        <Border DockPanel.Dock="Bottom" Padding="20,14,20,18">
            <Grid>
                <TextBlock x:Name="ErrorText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           MaxWidth="250"
                           TextWrapping="Wrap"
                           FontSize="{StaticResource CaptionFontSize}"
                           Foreground="{StaticResource ErrorBrush}"
                           Visibility="Collapsed"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="96" Height="36" Margin="0,0,10,0"
                            Style="{StaticResource GlassButtonStyle}" IsCancel="True" Click="OnCancel"/>
                    <Button Content="Save" Width="96" Height="36"
                            Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnSave"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= content ============================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource GlassScrollBarStyle}"/>
            </ScrollViewer.Resources>

            <StackPanel Margin="20,4,20,8">

                <!-- ===== HOTKEYS ===== -->
                <TextBlock Text="HOTKEYS" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Next track" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,6"/>
                        <controls:HotkeyCaptureControl x:Name="NextHotkeyBox"/>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <TextBlock Text="Previous track" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,6"/>
                        <controls:HotkeyCaptureControl x:Name="PreviousHotkeyBox"/>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <TextBlock Text="Play / Pause" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,6"/>
                        <controls:HotkeyCaptureControl x:Name="PlayPauseHotkeyBox"/>

                        <TextBlock Text="Click Change, then press the combination. Esc keeps the old one, Backspace clears it."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Margin="2,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== PLAYER ===== -->
                <TextBlock Text="PLAYER" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,18">
                    <StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="84" Height="84" VerticalAlignment="Top">
                                <Ellipse Width="112" Height="112" Fill="{StaticResource ArtworkGlowBrush}" IsHitTestVisible="False"/>

                                <Border CornerRadius="{StaticResource ArtworkCornerRadius}"
                                        Background="{StaticResource ArtworkPlaceholderBrush}"
                                        BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <TextBlock Text="&#x266A;" FontSize="32" Foreground="#77C9A8FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Border x:Name="ArtworkBorder"
                                        CornerRadius="{StaticResource ArtworkCornerRadius}"
                                        BorderBrush="#22FFFFFF" BorderThickness="1"
                                        Visibility="Collapsed">
                                    <Border.Background>
                                        <ImageBrush x:Name="ArtworkBrush" Stretch="UniformToFill"/>
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="NowPlayingTitle"
                                           Text="No active media"
                                           Style="{StaticResource TrackTitleStyle}"
                                           TextWrapping="NoWrap"/>
                                <TextBlock x:Name="NowPlayingArtist"
                                           Text=""
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Margin="0,3,0,0"
                                           TextWrapping="NoWrap"/>
                                <TextBlock x:Name="StatusText"
                                           Text="Start playing something to control it"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="NoWrap"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,4">
                            <Button x:Name="PreviousButton" Content="&#xE892;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource MediaButtonStyle}" Margin="0,0,14,0"
                                    ToolTip="Previous track" Click="OnPreviousClick"/>
                            <Button x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource PrimaryMediaButtonStyle}" Margin="0,0,14,0"
                                    ToolTip="Play / Pause" Click="OnPlayPauseClick"/>
                            <Button x:Name="NextButton" Content="&#xE893;" FontFamily="Segoe MDL2 Assets"
                                    Style="{StaticResource MediaButtonStyle}"
                                    ToolTip="Next track" Click="OnNextClick"/>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <TextBlock Text="Preferred player" Style="{StaticResource SecondaryTextStyle}" Margin="2,0,0,6"/>
                        <ComboBox x:Name="PlayerBox" Style="{StaticResource GlassComboBoxStyle}"/>
                        <TextBlock Text="Auto follows whatever Windows reports as the current media session."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" TextTrimming="None"
                                   Margin="2,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===== NOTIFICATIONS ===== -->
                <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,18">
                    <StackPanel>
                        <CheckBox x:Name="ShowPopupBox" Content="Track popup" Style="{StaticResource ToggleSwitchStyle}"/>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <CheckBox x:Name="ActiveMonitorBox" Content="Show on active monitor" Style="{StaticResource ToggleSwitchStyle}"/>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Popup duration"
                                       Style="{StaticResource PrimaryTextStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="DurationBox" Width="132"
                                      Style="{StaticResource GlassComboBoxStyle}"
                                      ItemStringFormat="{}{0:0.0} seconds"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== STARTUP ===== -->
                <TextBlock Text="STARTUP" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,18">
                    <CheckBox x:Name="StartupBox" Content="Start with Windows" Style="{StaticResource ToggleSwitchStyle}"/>
                </Border>

                <!-- ===== UPDATES ===== -->
                <TextBlock Text="UPDATES" Style="{StaticResource SectionHeaderStyle}"/>
                <Border Style="{StaticResource GlassCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Media Controller" Style="{StaticResource PrimaryTextStyle}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="VersionText" Grid.Column="1" Text="v0.4.0"
                                       Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically"
                                  Style="{StaticResource ToggleSwitchStyle}"/>

                        <Border Style="{StaticResource GlassSeparatorStyle}"/>

                        <TextBlock x:Name="UpdateStatusText"
                                   Text="Updates are checked in installed builds."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap" TextTrimming="None"/>

                        <TextBlock x:Name="UpdateNotesText"
                                   Margin="0,10,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxHeight="90"
                                   Visibility="Collapsed"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button x:Name="CheckUpdateButton" Content="Check now" Width="104" Height="34"
                                    Style="{StaticResource GlassButtonStyle}" Click="OnCheckUpdate"/>
                            <Button x:Name="UpdateActionButton" Content="Download update" Width="138" Height="34"
                                    Margin="10,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="Collapsed" Click="OnUpdateAction"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
