<UserControl x:Class="MediaController.UI.Controls.HotkeyCaptureControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="OnPreviewKeyDown">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Box"
                    Grid.Column="0"
                    Focusable="True"
                    MinHeight="36"
                    Padding="13,0"
                    CornerRadius="{StaticResource FieldCornerRadius}"
                    Background="{StaticResource GlassSunkenBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}"
                    BorderThickness="1"
                    LostKeyboardFocus="OnBoxLostFocus">
                <Border.Effect>
                    <DropShadowEffect x:Name="BoxGlow" BlurRadius="12" ShadowDepth="0"
                                      Color="{StaticResource PurpleGlowColor}" Opacity="0"/>
                </Border.Effect>
                <TextBlock x:Name="Display"
                           Text="Not assigned"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource UiFontFamily}"
                           FontSize="{StaticResource BodyFontSize}"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <Button x:Name="ChangeButton"
                    Grid.Column="1"
                    Content="Change"
                    Width="92"
                    Height="36"
                    Margin="10,0,0,0"
                    Style="{StaticResource GlassButtonStyle}"
                    Click="OnChangeClick"/>
        </Grid>

        <TextBlock x:Name="ErrorLine"
                   Foreground="{StaticResource ErrorBrush}"
                   FontFamily="{StaticResource UiFontFamily}"
                   FontSize="{StaticResource CaptionFontSize}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="2,6,0,0"/>
    </StackPanel>
</UserControl>
